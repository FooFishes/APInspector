<?xml version="1.0" encoding="utf-8"?>
<!--
    数据（含明文凭证）只通过应用内的手动备份导出（PRD 8），
    不进入系统云备份，也不参与设备间迁移。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
